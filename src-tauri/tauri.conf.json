{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swordkoban",
  "version": "1.0.1",
  "identifier": "com.swordkoban.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "https://swordkoban.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "Swordkoban",
        "width": 1280,
        "height": 840,
        "minWidth": 780,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
